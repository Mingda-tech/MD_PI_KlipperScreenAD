msgstr "Сканування USB-накопичувачів"

msgid "Select a file to copy it to the printer and verify it."
msgstr "Виберіть файл для копіювання на принтер і перевірки."

msgid "Signature and files verified. System and board checks run after confirmation."
msgstr "Підпис і файли перевірено. Систему та плати буде перевірено після підтвердження."

msgid "The SWUpdate engine is incompatible or has changed. Reinstall the verified engine."
msgstr "Механізм SWUpdate несумісний або змінений. Перевстановіть перевірений механізм."

msgid "The USB drive was removed before copying finished."
msgstr "USB-накопичувач від'єднано до завершення копіювання."

msgid "The USB package changed. Scan the drive again."
msgstr "Пакет на USB-накопичувачі змінився. Повторіть сканування."

msgid "The bundled offline update resources failed verification."
msgstr "Не вдалося перевірити надані ресурси автономного оновлення."

msgid "The installed version must be registered before updating."
msgstr "Перед оновленням необхідно зареєструвати встановлену версію."

