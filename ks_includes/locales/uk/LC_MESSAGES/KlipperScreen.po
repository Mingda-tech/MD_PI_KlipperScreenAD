msgid "Update cancelled"
msgstr "Оновлення скасовано"

msgid "Update complete"
msgstr "Оновлення завершено"

msgid "Update from a USB drive"
msgstr "Оновити з USB-накопичувача"

msgid "Update not completed"
msgstr "Оновлення не завершено"

