{
  "schemaVersion": 2,
  "device": {
    "arch": "aarch64"
  },
  "publicKey": "/etc/klipperscreen-update/release-public.pem",
  "maximumUpdateTemperature": 50,
  "engine": "swupdate",
  "swupdate": {
    "version": "2026.05",
    "binary": "/usr/libexec/klipperscreen-update/swupdate",
    "binarySha256": "REPLACED_BY_INSTALLER",
    "buildReceipt": "/usr/libexec/klipperscreen-update/build-info.json",
    "checkTimeoutSeconds": 300,
    "installTimeoutSeconds": 3600,
    "rescueTimeoutSeconds": 300
  }
}
